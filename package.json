{
  "name": "shadow-dojo",
  "private": true,
  "version": "0.2.0",
  "description": "Jogo de corte no navegador com rastreamento de mão (MediaPipe) e modo mouse.",
  "type": "module",
  "author": "Matheus Siqueira <hellomatheusdev@gmail.com> (https://www.matheussiqueira.dev)",
  "license": "MIT",
  "homepage": "https://github.com/matheussiqueira-dev/Clone-Fruit-Ninja#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matheussiqueira-dev/Clone-Fruit-Ninja.git"
  },
  "bugs": {
    "url": "https://github.com/matheussiqueira-dev/Clone-Fruit-Ninja/issues"
  },
  "scripts": {
    "dev": "vite",
    "dev:client": "vite",
    "dev:server": "tsx server/src/server.ts",
    "build": "vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "preview": "vite preview",
    "start:server": "tsx server/src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest",
    "generate:favicon": "node scripts/generate-favicon.mjs",
    "e2e": "playwright test",
    "sync:vision": "node scripts/sync-vision-assets.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@mediapipe/tasks-vision": "1.1.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "lucide-react": "1.59.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "fontkit": "2.0.4",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.3",
    "typescript": "~5.8.2",
    "typescript-eslint": "8.71.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
